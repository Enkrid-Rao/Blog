{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "www.251890411.xyz" }],
      "destination": "https://251890411.xyz/$1",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "blog.251890411.xyz" }],
      "destination": "https://251890411.xyz/$1",
      "permanent": true
    },
    {
      "source": "/关于",
      "destination": "/about",
      "permanent": true
    },
    {
      "source": "/关于/阅读指南",
      "destination": "/guide",
      "permanent": true
    },
    {
      "source": "/其他分享",
