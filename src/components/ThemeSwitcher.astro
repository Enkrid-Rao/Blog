---
const themes = [
  { id: 'obsidian', name: '黑曜', en: 'Obsidian' },
  { id: 'ivory', name: '象牙', en: 'Ivory' },
  { id: 'sepia', name: '暖纸', en: 'Sepia' },
];
---

<div class="theme-wrap" data-theme-wrap>
  <button
    class="icon-button theme-trigger"
    type="button"
    data-theme-trigger
    aria-label="切换主题"
    aria-haspopup="true"
    aria-expanded="false"
  >
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.15" aria-hidden="true">
      <circle cx="12" cy="12" r="8.2"></circle>
      <path d="M12 3.8a8.2 8.2 0 0 0 0 16.4Z" fill="currentColor" stroke="none"></path>
    </svg>
  </button>

  <div class="theme-popover" data-theme-popover role="menu" aria-label="外观" hidden>
    <p class="label">Appearance</p>
    {themes.map((theme) => (
      <button
        class="theme-option"
        type="button"
        role="menuitemradio"
        aria-checked="false"
        data-theme-option={theme.id}
      >
        <span class={`swatch swatch--${theme.id}`} aria-hidden="true"></span>
        <span class="theme-name">{theme.name}</span>
        <span class="theme-en">{theme.en}</span>
        <svg class="check" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true">
          <path d="m3 8.5 3.2 3.2L13 4.8"></path>
        </svg>
      </button>
    ))}
  </div>
</div>
