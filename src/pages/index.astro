---
import BaseLayout from '../layouts/BaseLayout.astro';
import InlineMath from '../components/InlineMath.astro';
import { site } from '../data/site';
import { chapters } from '../data/taxonomy';
import { getNotes, readingTime } from '../lib/notes';
import { posts } from '../data/posts';
import '../styles/home.css';

const featuredNotes = (await getNotes()).filter((note) => note.data.featured).slice(0, 3);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: site.name,
  url: new URL('/', Astro.site ?? 'https://www.251890411.xyz').href,
  description: site.description,
  inLanguage: 'zh-CN',
};

function chapterTitle(id: string) {
  return chapters[id as keyof typeof chapters]?.title ?? '';
}
---

<BaseLayout jsonLd={jsonLd}>
  <section class="hero">
    <div class="hero-aurora" aria-hidden="true">
      <div class="aurora-blob aurora-blob--a"></div>
      <div class="aurora-blob aurora-blob--b"></div>
      <div class="aurora-blob aurora-blob--c"></div>
    </div>
    <div class="hero-grid-lines" aria-hidden="true"></div>
    <div class="hero-glow" aria-hidden="true"></div>

    <div class="hero__inner">
      <div class="hero__copy">
        <p class="label eyebrow">
          <span class="eyebrow-dot" aria-hidden="true"></span>
          {site.hero.eyebrow}
        </p>

        <h1 class="hero-title">
          {site.hero.titleLines.map((line) => (
            <span class="line"><span>{line}</span></span>
          ))}
        </h1>

        <p class="hero-sub">{site.hero.subtitle}</p>
        <p class="hero-en">{site.hero.english}</p>

        <div class="hero-actions">
          <a class="btn btn--primary" href="/notes" data-magnetic>
            进入笔记
            <span class="arrow" aria-hidden="true">↗</span>
          </a>
          <a class="btn btn--glass" href="/writing">
            读日志
            <span class="arrow" aria-hidden="true">↗</span>
          </a>
        </div>

        <div class="hero-meta" aria-label="站点概览">
          {site.stats.map((stat) => (
            <div class="hero-stat">
              <span class="hero-stat__value">{stat.value}</span>
              <span class="hero-stat__label">{stat.label}</span>
            </div>
          ))}
        </div>
      </div>

      <aside class="hero-object" aria-label="当前状态">
        <div class="object-card" data-tilt data-specular>
          <div class="object-top">
            <span class="label">Currently</span>
            <span class="object-time" data-clock>--:--:-- CST</span>
          </div>

          <div class="object-orb" aria-hidden="true">
            <span class="orb-halo"></span>
            <span class="orb-ring orb-ring--outer"></span>
            <span class="orb-ring orb-ring--inner"></span>
            <span class="orb-core"></span>
          </div>

          <div class="object-content">
            <div class="object-list">
              {site.now.map((item) => (
                <div class="object-row">
                  <span class="object-row__num">{item.index}</span>
                  <span class="object-row__label">{item.label}</span>
                  <span class="object-row__detail">{item.detail}</span>
                </div>
              ))}
            </div>
            <div class="object-foot">
              <span class="status-dot" aria-hidden="true"></span>
              正在更新
            </div>
          </div>
        </div>
      </aside>
    </div>

    <div class="hero-scroll" aria-hidden="true">
      <span class="hero-scroll__line"></span>
      <span class="label">Scroll</span>
    </div>
  </section>

  <section class="section" id="notes">
    <div class="container">
      <div class="section-head" data-reveal>
        <div>
          <p class="label">01 / Selected Notes</p>
          <h2 class="section-title">精选笔记</h2>
        </div>
        <a class="text-link section-head__link" href="/notes">
          全部笔记 <span class="arrow" aria-hidden="true">↗</span>
        </a>
      </div>

      <div class="notes-grid">
        {featuredNotes.map((note, index) => (
          <a
            class:list={['note-card', { 'note-card--wide': index === 0 }]}
            href={`/notes/${note.id}`}
            data-reveal
            data-specular
            style={`--delay: ${index}`}
          >
            {index === 0 && <span class="note-card__orb" aria-hidden="true"></span>}
            <div class="note-card__top">
              <span class="note-card__index">{String(index + 1).padStart(2, '0')}</span>
              <span class="note-card__chapter">
                {chapterTitle(note.data.chapter)} · {readingTime(note.body)} min
              </span>
            </div>
            <div class="note-card__body">
              <h3 class="note-card__title"><InlineMath text={note.data.title} /></h3>
              <p class="note-card__desc">{note.data.description}</p>
            </div>
            <div class="note-card__foot">
              <div class="note-card__tags">
                {note.data.tags.map((tag) => <span class="tag">{tag}</span>)}
              </div>
              <span class="note-card__arrow" aria-hidden="true">↗</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section writing" id="writing">
    <div class="container">
      <div class="writing__grid">
        <aside class="writing__aside" data-reveal>
          <p class="label">02 / Writing</p>
          <span class="writing__mark" aria-hidden="true">W</span>
        </aside>

        <div class="writing__main" data-reveal style="--delay: 1">
          <blockquote class="writing__quote">
            写作，是把想清楚的事，<br />
            再想一遍。
          </blockquote>
          <p class="writing__note">
            这里放随笔、CTF Writeups 和项目记录。现在只有一篇关于本站重构的短文，
            其余位置先空着。
          </p>

          <div class="post-list">
            {posts.map((post) => (
              <a class="post-row" href={`/writing#${post.slug}`}>
                <span class="post-row__date">{post.displayDate}</span>
                <span class="post-row__title">{post.title}</span>
                <span class="post-row__type">{post.type}</span>
                <span class="post-row__arrow" aria-hidden="true">↗</span>
              </a>
            ))}
            <div class="post-row post-row--ghost">
              <span class="post-row__date">TBA</span>
              <span class="post-row__title">CTF Writeups</span>
              <span class="post-row__type">预留</span>
              <span class="post-row__arrow" aria-hidden="true">·</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section" id="lab">
    <div class="container">
      <div class="lab-panel" data-reveal>
        <div class="lab-panel__copy">
          <p class="label">03 / The Lab</p>
          <h2 class="lab-title">diary</h2>
          <p class="lab-sub">A quieter place to keep the days.</p>
          <p class="lab-desc">
            一个更私人的记录空间。它不会出现在时间流里，也不急着被谁读到。
            先在这里留一个位置。
          </p>
          <div class="lab-meta">
            <span class="status-pill">
              <span class="status-dot" aria-hidden="true"></span>
              规划中
            </span>
            <a class="text-link" href="/lab">
              看看进度 <span class="arrow" aria-hidden="true">↗</span>
            </a>
          </div>
        </div>

        <div class="lab-visual" aria-hidden="true">
          <div class="diary-stack">
            <div class="diary-sheet diary-sheet--back"></div>
            <div class="diary-sheet diary-sheet--mid"></div>
            <div class="diary-sheet diary-sheet--front">
              <div class="diary-sheet__top">
                <span class="diary-sheet__title">diary</span>
                <span class="diary-sheet__date">2026 / —</span>
              </div>
              <div class="diary-lines">
                <span class="diary-line"></span>
                <span class="diary-line"></span>
                <span class="diary-line"></span>
                <span class="diary-line"></span>
              </div>
              <div class="diary-sheet__foot">
                <span class="status-dot"></span>
                private log
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--tight" id="about">
    <div class="container">
      <div class="about-band">
        <div data-reveal>
          <p class="label">04 / About</p>
          <div class="about-monogram" aria-hidden="true">r</div>
        </div>

        <div class="about-copy" data-reveal style="--delay: 1">
          <p class="about-lead">我是 rxx。</p>
          <p class="about-text">
            在这里记录数学、代码，以及一些没想清楚的事。
            笔记是长期维护的，日志是随手写下的；两者分开，才都不别扭。
          </p>
          <div class="about-links">
            <a class="btn btn--glass" href="/about">
              关于这个站
              <span class="arrow" aria-hidden="true">↗</span>
            </a>
            <a class="btn btn--ghost" href={site.github} target="_blank" rel="noreferrer">
              GitHub
              <span class="arrow" aria-hidden="true">↗</span>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
