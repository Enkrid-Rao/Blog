---
import BaseLayout from '../../layouts/BaseLayout.astro';
import InlineMath from '../../components/InlineMath.astro';
import { chapterList, courseList, getChaptersForCourse, subjects } from '../../data/taxonomy';
import { formatDate, getNotes, latestUpdated, readingTime } from '../../lib/notes';
import '../../styles/pages.css';

const allNotes = await getNotes();
const total = allNotes.length;
const lastUpdated = latestUpdated(allNotes);
const chapterCount = new Set(allNotes.map((note) => note.data.chapter)).size;

const courseCards = courseList.map((course) => {
  const courseNotes = allNotes.filter((note) => note.data.course === course.id);
  return {
    ...course,
    subjectTitle: subjects[course.subject].title,
    noteCount: courseNotes.length,
    chapterCount: getChaptersForCourse(course.id).length,
    lastUpdated: latestUpdated(courseNotes),
  };
});

const recentNotes = allNotes
  .filter((note) => Boolean(note.data.updated))
  .sort((a, b) => (b.data.updated?.getTime() ?? 0) - (a.data.updated?.getTime() ?? 0))
  .slice(0, 6);

function chapterTitle(id: string): string {
  return chapterList.find((chapter) => chapter.id === id)?.title ?? '';
}
---

<BaseLayout
  title="笔记 — rxx"
  description="数论、二次剩余、原根：一个按课程与章节组织的笔记库。"
>
  <section class="page-hero">
    <div class="container">
      <p class="label page-hero__label">01 / Notes</p>
      <h1 class="page-title">笔记库</h1>
      <p class="page-lede">按学科与课程组织，适合从头读，也适合随手查。</p>
      <div class="page-hero__meta">
        <span><span class="dot"></span>{total} 篇笔记</span>
        <span>{chapterCount} 个章节</span>
        <span>{courseCards.length} 门课程</span>
        <span>最后更新 {formatDate(lastUpdated)}</span>
      </div>
    </div>
  </section>

  <section class="page-body">
    <div class="container">
      <div class="course-grid">
        {courseCards.map((course, index) => (
          <a
            class:list={['course-card', { 'course-card--muted': course.status === 'planned' }]}
            href={`/notes/${course.subject}/${course.id}`}
            data-reveal
            style={`--delay: ${index}`}
          >
            <div class="course-card__top">
              <span class="label">{course.subjectTitle} / {course.en}</span>
              {course.status === 'active' ? (
                <span class="status-pill">
                  <span class="status-dot" aria-hidden="true"></span>
                  进行中
                </span>
              ) : (
                <span class="status-pill">筹备中</span>
              )}
            </div>
            <h2 class="course-card__title">{course.title}</h2>
            <p class="course-card__desc">{course.description}</p>
            <div class="course-card__meta">
              {course.status === 'active' ? (
                <>
                  <span>{course.chapterCount} 章</span>
                  <span>{course.noteCount} 篇</span>
                  <span>更新 {formatDate(course.lastUpdated)}</span>
                </>
              ) : (
                <span>章节规划中</span>
              )}
            </div>
            <span class="course-card__arrow" aria-hidden="true">↗</span>
          </a>
        ))}
      </div>

      <section class="notes-recent">
        <div class="notes-section-head">
          <div>
            <p class="label">Recent</p>
            <h2 class="notes-section-title">最近更新</h2>
          </div>
          <a class="text-link" href="/archive">
            按时间查看 <span class="arrow" aria-hidden="true">↗</span>
          </a>
        </div>

        <div class="entry-list">
          {recentNotes.map((note) => (
            <a class="entry-row" href={`/notes/${note.id}`}>
              <span class="entry-row__meta">
                {formatDate(note.data.updated)}
                <br />
                {chapterTitle(note.data.chapter)}
              </span>
              <span>
                <span class="entry-row__title"><InlineMath text={note.data.title} /></span>
                <span class="entry-row__desc">{note.data.description}</span>
              </span>
              <span class="entry-row__kind">{readingTime(note.body)} min</span>
            </a>
          ))}
        </div>
      </section>
    </div>
  </section>
</BaseLayout>
