---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { postTypes, posts } from '../../data/posts';
import '../../styles/pages.css';

const counts = postTypes.map((type) => ({
  ...type,
  count: posts.filter((post) => post.type === type.type).length,
}));
---

<BaseLayout
  title="日志 — rxx"
  description="随笔、CTF Writeups 与项目记录。"
>
  <section class="page-hero">
    <div class="container">
      <p class="label page-hero__label">02 / Writing</p>
      <h1 class="page-title">日志</h1>
      <p class="page-lede">
        按时间发生的东西：随笔、CTF Writeups、项目记录。
        比笔记松一点，也比笔记诚实一点。
      </p>
      <div class="filter-row">
        <span class="filter-chip filter-chip--active" aria-current="page">
          全部 <span class="count">{posts.length}</span>
        </span>
        {counts.map((type) => (
          <a class="filter-chip" href={`/writing/${type.slug}`}>
            {type.type} <span class="count">{type.count}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="page-body">
    <div class="container">
      <div class="posts-index" data-reveal>
        {posts.map((post) => (
          <a class="post-card" href={`/writing/${post.slug}`}>
            <span class="post-card__date">{post.displayDate}</span>
            <div>
              <h2 class="post-card__title">{post.title}</h2>
              <p class="post-card__excerpt">{post.excerpt}</p>
            </div>
            <div class="post-card__meta">
              <span>{post.type}</span>
              <span>{post.reading}</span>
              <span class="post-card__arrow" aria-hidden="true">↗</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
